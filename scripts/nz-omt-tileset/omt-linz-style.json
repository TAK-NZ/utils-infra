{
  "version": 8,
  "name": "NZ Topographic (LINZ colours, OMT schema)",
  "metadata": {
    "description": "LINZ topographic colour palette re-applied to the OMT-schema tiles produced by scripts/nz-omt-tileset/. Upload via ATAK's hamburger menu -> Imagery -> (select the nz-omt or nz-omt-buildings layer) -> Set Layer Style. See scripts/nz-omt-tileset/README.md.",
    "openmaptiles:comment": "ATAK's MapBoxGLStyleSheet_parse ignores the top-level 'source' field entirely -- it matches purely on each layer's 'source-layer' string against the tile's own layer names. The 'sources' block below is cosmetic (for compatibility with desktop style editors), not read by ATAK."
  },
  "sources": {
    "nz-omt": {
      "type": "vector",
      "url": "https://tiles.{domain}/data/nz-omt-buildings.json"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "rgba(232, 232, 232, 1)" }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "paint": { "fill-color": "rgba(180, 214, 163, 1)" }
    },
    {
      "id": "landcover-sand",
      "type": "fill",
      "source-layer": "landcover",
      "filter": ["==", "class", "sand"],
      "minzoom": 9,
      "paint": { "fill-color": "rgba(226, 226, 226, 0.85)" }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source-layer": "landcover",
      "filter": ["==", "class", "grass"],
      "paint": { "fill-color": "rgba(204, 222, 195, 1)" }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "minzoom": 8,
      "maxzoom": 15,
      "paint": { "fill-color": "rgba(164, 164, 164, 0.35)" }
    },
    {
      "id": "landuse-cemetery",
      "type": "fill",
      "source-layer": "landuse",
      "filter": ["==", "class", "cemetery"],
      "minzoom": 12,
      "paint": { "fill-color": "rgba(187, 179, 159, 0.75)" }
    },
    {
      "id": "landuse-commercial",
      "type": "fill",
      "source-layer": "landuse",
      "filter": ["==", "class", "commercial"],
      "minzoom": 10,
      "paint": { "fill-color": "rgba(205, 205, 205, 0.6)" }
    },
    {
      "id": "landuse-industrial",
      "type": "fill",
      "source-layer": "landuse",
      "filter": ["==", "class", "industrial"],
      "minzoom": 10,
      "paint": { "fill-color": "rgba(216, 213, 213, 0.75)" }
    },
    {
      "id": "landuse-railway",
      "type": "fill",
      "source-layer": "landuse",
      "filter": ["==", "class", "railway"],
      "minzoom": 11,
      "paint": { "fill-color": "rgba(158, 153, 153, 0.4)" }
    },
    {
      "id": "landuse-school",
      "type": "fill",
      "source-layer": "landuse",
      "filter": ["==", "class", "school"],
      "minzoom": 12,
      "paint": { "fill-color": "rgba(240, 240, 205, 0.5)" }
    },
    {
      "id": "landuse-hospital",
      "type": "fill",
      "source-layer": "landuse",
      "filter": ["==", "class", "hospital"],
      "minzoom": 12,
      "paint": { "fill-color": "rgba(240, 205, 210, 0.5)" }
    },
    {
      "id": "park",
      "type": "fill",
      "source-layer": "park",
      "filter": ["==", "class", "public_park"],
      "minzoom": 11,
      "paint": { "fill-color": "rgba(121, 195, 128, 0.2)" }
    },
    {
      "id": "water",
      "type": "fill",
      "source-layer": "water",
      "paint": { "fill-color": "rgba(184, 220, 242, 1)" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source-layer": "waterway",
      "minzoom": 9,
      "paint": {
        "line-color": "rgba(76, 147, 226, 0.75)",
        "line-width": 1
      }
    },
    {
      "id": "aeroway-runway",
      "type": "fill",
      "source-layer": "aeroway",
      "filter": ["==", "class", "runway"],
      "minzoom": 10,
      "paint": { "fill-color": "rgba(193, 193, 193, 0.5)" }
    },
    {
      "id": "aeroway-taxiway",
      "type": "fill",
      "source-layer": "aeroway",
      "filter": ["==", "class", "taxiway"],
      "minzoom": 12,
      "paint": { "fill-color": "rgba(211, 211, 211, 0.5)" }
    },
    {
      "id": "transportation-track-path",
      "type": "line",
      "source-layer": "transportation",
      "filter": ["in", "class", "track", "path"],
      "minzoom": 12,
      "paint": {
        "line-color": "rgba(78, 78, 78, 0.8)",
        "line-width": 1,
        "line-dasharray": [2.5, 3]
      }
    },
    {
      "id": "transportation-rail",
      "type": "line",
      "source-layer": "transportation",
      "filter": ["in", "class", "rail", "transit"],
      "minzoom": 10,
      "paint": {
        "line-color": "rgba(67, 61, 61, 0.95)",
        "line-width": 1.5
      }
    },
    {
      "id": "transportation-cable-car",
      "type": "line",
      "source-layer": "transportation",
      "filter": ["==", "class", "cable_car"],
      "minzoom": 11,
      "paint": {
        "line-color": "rgba(24, 23, 23, 0.8)",
        "line-width": 1.25
      }
    },
    {
      "id": "transportation-service-minor",
      "type": "line",
      "source-layer": "transportation",
      "filter": ["in", "class", "service", "minor"],
      "minzoom": 12,
      "paint": {
        "line-color": "rgba(255, 254, 252, 1)",
        "line-width": 1.5
      }
    },
    {
      "id": "transportation-secondary-tertiary",
      "type": "line",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "minzoom": 10,
      "paint": {
        "line-color": "rgba(217, 184, 127, 1)",
        "line-width": 2.5
      }
    },
    {
      "id": "transportation-trunk-primary",
      "type": "line",
      "source-layer": "transportation",
      "filter": ["in", "class", "trunk", "primary"],
      "minzoom": 8,
      "paint": {
        "line-color": "rgba(210, 162, 84, 1)",
        "line-width": 3.5
      }
    },
    {
      "id": "transportation-motorway",
      "type": "line",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "minzoom": 6,
      "paint": {
        "line-color": "rgba(240, 164, 82, 1)",
        "line-width": 4
      }
    },
    {
      "id": "transportation-ferry",
      "type": "line",
      "source-layer": "transportation",
      "filter": ["==", "class", "ferry"],
      "minzoom": 8,
      "paint": {
        "line-color": "rgba(0, 140, 204, 1)",
        "line-width": 1,
        "line-dasharray": [15, 10]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source-layer": "building",
      "minzoom": 16,
      "paint": {
        "fill-color": "rgba(190, 190, 190, 1)",
        "fill-opacity": 1
      }
    },
    {
      "id": "transportation-name",
      "type": "symbol",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-size": 10
      },
      "paint": {
        "text-halo-color": "rgba(243, 243, 242, 0.9)",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "waterway-name",
      "type": "symbol",
      "source-layer": "waterway",
      "filter": ["has", "name"],
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-size": 12
      },
      "paint": {
        "text-color": "rgba(0, 140, 204, 1)",
        "text-halo-color": "rgba(239, 239, 239, 0.8)",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "water-name",
      "type": "symbol",
      "source-layer": "water_name",
      "minzoom": 5,
      "layout": {
        "text-field": "{name}",
        "text-size": 12
      },
      "paint": {
        "text-color": "rgba(0, 140, 204, 1)",
        "text-halo-color": "rgba(255, 255, 255, 1)",
        "text-halo-width": 1
      }
    },
    {
      "id": "poi-airfield-heliport",
      "type": "symbol",
      "source-layer": "poi",
      "filter": ["in", "class", "airfield", "heliport"],
      "minzoom": 12,
      "layout": {
        "text-field": "{name}",
        "text-size": 10
      },
      "paint": {
        "text-color": "rgba(129, 123, 123, 1)",
        "text-halo-color": "rgba(255, 255, 255, 1)",
        "text-halo-width": 1
      }
    },
    {
      "id": "poi-generic",
      "type": "symbol",
      "source-layer": "poi",
      "filter": ["!in", "class", "airfield", "heliport"],
      "minzoom": 14,
      "layout": {
        "text-field": "{name}",
        "text-size": 9
      },
      "paint": {
        "text-color": "rgba(73, 68, 68, 1)",
        "text-halo-color": "rgba(255, 255, 255, 1)",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-island",
      "type": "symbol",
      "source-layer": "place",
      "filter": ["in", "class", "island", "archipelago"],
      "minzoom": 5,
      "maxzoom": 12,
      "layout": { "text-field": "{name}", "text-size": 14 },
      "paint": {
        "text-color": "rgba(0, 0, 0, 1)",
        "text-halo-color": "rgba(255, 252, 252, 1)",
        "text-halo-width": 2
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source-layer": "place",
      "filter": ["==", "class", "city"],
      "minzoom": 4,
      "layout": { "text-field": "{name}", "text-size": 15 },
      "paint": {
        "text-color": "rgba(0, 0, 0, 1)",
        "text-halo-color": "rgba(255, 252, 252, 1)",
        "text-halo-width": 2
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source-layer": "place",
      "filter": ["==", "class", "town"],
      "minzoom": 8,
      "layout": { "text-field": "{name}", "text-size": 12 },
      "paint": {
        "text-color": "rgba(0, 0, 0, 1)",
        "text-halo-color": "rgba(255, 252, 252, 1)",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-suburb-locality",
      "type": "symbol",
      "source-layer": "place",
      "filter": ["in", "class", "suburb", "locality"],
      "minzoom": 10,
      "layout": { "text-field": "{name}", "text-size": 10 },
      "paint": {
        "text-color": "rgba(0, 0, 0, 1)",
        "text-halo-color": "rgba(255, 252, 252, 1)",
        "text-halo-width": 1.5
      }
    }
  ]
}
