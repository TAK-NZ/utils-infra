*.js
!jest.config.js
!ais-proxy/server.js
!weather-proxy/server.js
!camera-proxy/server.js
!terrain-proxy/server.js
!power-outages/**/*.js
!scripts/*.js
*.d.ts
node_modules

# Local dev config files (may contain real tokens)
*.local.json

# CDK asset staging directory
.cdk.staging
cdk.out

# Environment files
.env
.env.local
.env.*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Dependency directories
node_modules/
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# next.js build output
.next

# nuxt.js build output
.nuxt

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless

# IDE
.vscode
.idea

# OS
.DS_Store
Thumbs.db

# Generated GRG files
grg-output/

# Display proxy config contains real API tokens — upload to S3, don't commit
display-proxy/Utils-Display-Proxy-Config.json

# Allow display-proxy JS source and static assets (excluded by *.js CDK rule above)
!display-proxy/*.js
!display-proxy/static/*.js

# Flooding hazard-map pipeline — downloaded source zips, extracted rasters,
# generated overlays and TAK packages, and the per-run work dir are all large
# and reproducible from S3. Only the scripts, README and .env.example are tracked.
data-packages/hazards/flooding/work/
data-packages/hazards/flooding/catchment-work/
data-packages/hazards/flooding/overlays/
data-packages/hazards/flooding/packages/
data-packages/hazards/flooding/*.zip
data-packages/hazards/flooding/*.tif
data-packages/hazards/flooding/*.tiff
data-packages/hazards/flooding/*.kmz

# Tsunami evacuation-zone pipeline — fetched/generated intermediates and the
# built KMZ/package are reproducible from the NEMA service. Only scripts,
# README and .env.example are tracked.
data-packages/hazards/tsunami/work/
data-packages/hazards/tsunami/*.kmz
data-packages/hazards/tsunami/*.zip
