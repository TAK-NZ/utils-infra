# Flooding hazard-map pipeline configuration.
#
# Copy this file to `.env` in this directory and fill in the real values.
# `.env` is git-ignored so bucket names, AWS profile, the CloudTAK URL and the
# API token never end up in the repository.
#
#   cp data-packages/hazards/flooding/.env.example data-packages/hazards/flooding/.env
#   $EDITOR data-packages/hazards/flooding/.env
#   bash data-packages/hazards/flooding/process-flood-hazard-maps.sh

# --- Source S3 (read-only; the pipeline never writes here) ------------------
# Bucket and key prefix holding the per-region source zips (<Region>_0C.zip).
SOURCE_BUCKET=your-source-bucket-name
SOURCE_PREFIX=flood-hazard-map-source/

# AWS profile and region used to read the source bucket.
AWS_PROFILE=your-aws-profile
AWS_REGION=ap-southeast-2

# --- CloudTAK upload target -------------------------------------------------
# Base URL of the CloudTAK instance, e.g. https://map.demo.tak.nz
CLOUDTAK_URL=https://map.example.tak.nz

# API token from POST /api/profile/token, in the etl.<jwt> format.
# Treat this as a secret. Rotate if it ever leaks.
CLOUDTAK_TOKEN=etl.replace-with-your-token

# TAK channel to assign the uploaded packages to. Quote the value — channel
# names usually contain spaces, e.g. "XtraTools - Data Packages"
CLOUDTAK_CHANNELS="XtraTools - Data Packages"
