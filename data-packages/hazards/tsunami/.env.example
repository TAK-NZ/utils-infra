# Tsunami evacuation-zone pipeline configuration.
#
# Copy this file to `.env` in this directory and fill in the real values.
# `.env` is git-ignored so the CloudTAK URL and API token never end up in the
# repository.
#
#   cp data-packages/hazards/tsunami/.env.example data-packages/hazards/tsunami/.env
#   $EDITOR data-packages/hazards/tsunami/.env
#   bash data-packages/hazards/tsunami/build-tsunami-evac-zones.sh

# --- Source (read-only) -----------------------------------------------------
# NEMA "Aotearoa Tsunami Evacuation Zones (public)" ArcGIS Feature Service.
# This is the national dataset behind the getready.govt.nz tsunami map.
SOURCE_URL=https://services5.arcgis.com/cJn6oR1QqErYBL5d/arcgis/rest/services/Aotearoa_Tsunami_Evac_Zones/FeatureServer/117

# --- CloudTAK upload target -------------------------------------------------
CLOUDTAK_URL=https://map.example.tak.nz

# API token from POST /api/profile/token, in the etl.<jwt> format. Secret.
CLOUDTAK_TOKEN=etl.replace-with-your-token

# TAK channel to assign the uploaded package to. Quote the value.
CLOUDTAK_CHANNELS="XtraTools - Data Packages"
